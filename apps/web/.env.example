# Leave these unset to run in demo mode (no backend, made-up data).

# Supabase project (Settings > API). The anon key is safe to ship in the browser;
# row-level security protects the data.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Event shown on the public leaderboard and TV (events.id).
VITE_PUBLIC_EVENT_ID=

# Optional: comma-separated sponsor names for the TV sponsor strip.
VITE_SPONSORS=
